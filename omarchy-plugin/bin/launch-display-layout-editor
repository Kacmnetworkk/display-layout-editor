#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
binary="$script_dir/displayeditor-rav"

if [[ ! -x "$binary" ]]; then
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="Display Layout Editor" \
      "Display Layout Editor unavailable" \
      "Reinstall the Omarchy plugin to restore its bundled binary."
  fi
  exit 1
fi

exec "$binary"
